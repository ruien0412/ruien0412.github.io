---
interface Props {
  buildTime: string;
  shortCommitHash: string;
  branchName: string;
}

const { buildTime, shortCommitHash, branchName } = Astro.props;
---

<div
  class="text-xs text-gray-500 space-y-1"
  data-reveal
  style="--reveal-delay: 600ms"
>
  <p>
    Build: <span class="font-mono text-gray-400">{shortCommitHash}</span>
    {
      branchName !== "unknown" && branchName !== "dev" && (
        <span class="ml-2">
          on{" "}
          <a
            href={`https://github.com/ruien0412/ruien0412.github.io/tree/${branchName}`}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hover:underline transition-colors"
          >
            {branchName}
          </a>
        </span>
      )
    }
  </p>
  {
    buildTime && buildTime !== "unknown" && (
      <p>
        Built:{" "}
        <span class="text-gray-400">
          {new Date(buildTime).toLocaleString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            timeZone: "UTC",
          })}{" "}
          UTC
        </span>
      </p>
    )
  }
</div>
