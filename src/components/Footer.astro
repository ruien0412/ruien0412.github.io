---
import { FaGithub, FaLinkedin } from "react-icons/fa";
import { MdEmail } from "react-icons/md";
import { SiGitea } from "react-icons/si";
import BuildInfo from "./BuildInfo.astro";
import { buildInfo } from "../build-info";
const socialLinks = [
  {
    href: "https://github.com/ruien0412",
    icon: FaGithub,
    label: "GitHub",
  },
  {
    href: "https://gitea.com/zre",
    icon: SiGitea,
    label: "Gitea",
  },
  {
    href: "https://linkedin.com/in/ruien-zhang",
    icon: FaLinkedin,
    label: "LinkedIn",
  },
  {
    href: "mailto:me@zre.tw",
    icon: MdEmail,
    label: "Email",
  },
];
---

<footer
  class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 py-16"
>
  <div class="container mx-auto px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      {/* 頂部內容 */}
      <div class="mb-12" data-reveal>
        <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
          讓我們聯繫
        </h3>
        <p class="text-gray-600 dark:text-gray-400 lxgw-wenkai-mono-tc-regular">
          對我的作品感興趣？隨時與我聯繫，我很樂意討論您的想法和機會。
        </p>
      </div>

      {/* 社交連結 */}
      <div class="flex flex-wrap gap-4 mb-12">
        {
          socialLinks.map((link, index) => {
            const IconComponent = link.icon;
            const isExternal = link.href.startsWith("http");
            return (
              <a
                href={link.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-blue-100 dark:hover:bg-blue-950 text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition hover:scale-105 active:scale-95"
                data-reveal
                style={`--reveal-delay: ${200 + index * 50}ms`}
              >
                <IconComponent className="w-5 h-5" />
                <span class="font-medium text-sm">{link.label}</span>
              </a>
            );
          })
        }
      </div>

      {/* 分隔線 */}
      <div class="h-px bg-gray-200 dark:bg-gray-800 mb-8"></div>

      {/* 頁腳資訊 */}
      <div
        class="text-center lxgw-wenkai-mono-tc-regular"
        data-reveal="fade"
        style="--reveal-delay: 400ms"
      >
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
          © {new Date().getFullYear()} 張睿恩 (Rui-En Zhang)
        </p>
        {
          buildInfo && buildInfo.shortCommitHash !== "dev" && (
            <BuildInfo
              buildTime={buildInfo.buildTime}
              shortCommitHash={buildInfo.shortCommitHash}
              branchName={buildInfo.branchName}
            />
          )
        }
      </div>
    </div>
  </div>
</footer>
