---
interface Props {
  icon: string;
  title: string;
  description: string;
  skills: string[];
  centered?: boolean;
  // 進場動畫延遲（毫秒），讓同一排的卡片依序出現
  revealDelay?: number;
}

const {
  icon,
  title,
  description,
  skills,
  centered = false,
  revealDelay = 0,
} = Astro.props;
---

<div
  class={`p-6 rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 transition-all hover:shadow-md hover:border-blue-200 dark:hover:border-blue-900 ${
    centered ? "md:col-span-2 lg:col-span-3 mx-auto max-w-2xl" : ""
  }`}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
>
  <div
    class={`flex items-start gap-4 mb-6 ${centered ? "flex-col text-center items-center" : ""}`}
  >
    <div class="text-4xl shrink-0 flex items-center justify-center h-12">
      {icon}
    </div>
    <div class={centered ? "w-full" : ""}>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
        {title}
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
        {description}
      </p>
    </div>
  </div>
  <div class={`flex flex-wrap gap-2 ${centered ? "justify-center" : ""}`}>
    {
      skills.map((skill) => (
        <span class="inline-block px-3 py-1.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium transition-colors hover:bg-gray-200 dark:hover:bg-gray-700">
          {skill}
        </span>
      ))
    }
  </div>
</div>
