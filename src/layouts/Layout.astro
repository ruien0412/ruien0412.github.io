---
import BaseHead, { type Props as BaseHeadProps } from "../components/BaseHead.astro";
type Props = BaseHeadProps;

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="zh-TW" style={{ fontFamily: "var(--font-noto-sans-tc)" }}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="antialiased">
      <slot />
  </body>
</html>
