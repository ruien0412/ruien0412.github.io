---
import BaseHead, { type Props as BaseHeadProps } from "../components/BaseHead.astro";
import ScrollProgress from "../components/ScrollProgress";
import ScrollToTop from "../components/ScrollToTop";
import Header from "../components/Header";
import Footer from "../components/Footer.astro";
type Props = BaseHeadProps;

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="zh-TW" style={{ fontFamily: "var(--font-noto-sans-tc)" }}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="antialiased">
    <ScrollProgress client:visible />
    <ScrollToTop client:idle />
    <div class="min-h-screen bg-white dark:bg-gray-950">
      <Header client:load pathname={Astro.url.pathname} />
      <slot />
      <Footer />
    </div>
  </body>
</html>
