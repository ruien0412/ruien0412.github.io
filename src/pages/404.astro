---
import Layout from "../layouts/Layout.astro";

const REDIRECT_SECONDS = 5;

const links = [
  { href: "/projects", label: "查看專案" },
  { href: "/about", label: "關於我" },
  { href: "/skills", label: "技能" },
  { href: "/contact", label: "聯絡我" },
];
---

<Layout
  title="404 Not Found | 張睿恩 (Rui-En Zhang)"
  description="找不到頁面 - 張睿恩 (Rui-En Zhang) 的個人網站"
>
  <div
    class="min-h-screen bg-white dark:bg-gray-950 flex flex-col items-center justify-center px-6"
  >
    <div class="text-center max-w-2xl" data-reveal>
      {/* 404 號碼 */}
      <div class="mb-8">
        <h1 class="text-8xl md:text-9xl font-bold text-gray-900 dark:text-white">
          404
        </h1>
      </div>

      {/* 標題和描述 */}
      <div class="mb-12">
        <h2
          class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4"
        >
          頁面不存在
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          抱歉，您訪問的頁面不存在或已被移除。
        </p>
      </div>

      {/* 倒計時卡片 */}
      <div
        class="mb-12 bg-gray-50 dark:bg-gray-900 rounded-xl p-8 border border-gray-200 dark:border-gray-800"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        <p class="text-gray-600 dark:text-gray-400 mb-4">自動跳轉中...</p>
        <div
          class="text-5xl md:text-6xl font-bold text-blue-600 dark:text-blue-400 mb-4"
        >
          <span data-countdown>{REDIRECT_SECONDS}</span>s
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          將在 <span data-countdown>{REDIRECT_SECONDS}</span> 秒後返回首頁
        </p>

        {/* 進度條 */}
        <div
          class="mt-6 w-full bg-gray-200 dark:bg-gray-800 rounded-full h-1 overflow-hidden"
        >
          <div
            class="countdown-bar bg-blue-600 dark:bg-blue-400 h-full origin-left"
            style={`animation-duration: ${REDIRECT_SECONDS}s`}
          >
          </div>
        </div>
      </div>

      {/* 按鈕 */}
      <div class="space-y-4" data-reveal style="--reveal-delay: 400ms">
        <a
          href="/"
          class="block w-full px-8 py-3 bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-700 text-white rounded-lg font-medium transition-colors"
        >
          立即返回首頁
        </a>

        {/* 導航連結 */}
        <div class="pt-4 text-sm text-gray-600 dark:text-gray-400 space-y-2">
          <p>或者您可以瀏覽：</p>
          <div class="flex flex-wrap justify-center gap-4">
            {
              links.map((link, i) => (
                <>
                  {i > 0 && <span class="text-gray-400">•</span>}
                  <a
                    href={link.href}
                    class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors"
                  >
                    {link.label}
                  </a>
                </>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .countdown-bar {
    animation: countdown linear forwards;
  }

  @keyframes countdown {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const counters = document.querySelectorAll("[data-countdown]");
    if (counters.length === 0) return;

    let remaining = Number(counters[0].textContent);
    const timer = setInterval(() => {
      // 使用者在倒數結束前點了其他連結
      if (!counters[0].isConnected) return clearInterval(timer);

      remaining -= 1;
      counters.forEach((el) => (el.textContent = String(remaining)));
      if (remaining <= 0) {
        clearInterval(timer);
        window.location.href = "/";
      }
    }, 1000);
  });
</script>
