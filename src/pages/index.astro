---
import { HiOutlineArrowRight, HiOutlineSparkles } from "react-icons/hi2";
import TypewriterText from "../components/TypewriterText.astro";
import PageLayout from "../layouts/PageLayout.astro";

const descriptions = [
  "專注於打造實用且易用的應用程式，在過程中不斷學習與調整，努力把想法一步步實現。",
  "喜歡面對各種技術挑戰，透過持續的探索與練習，期望為使用者帶來更好的體驗。",
  "相信技術與創意能帶來改變，保持好奇心與學習動力，踏實累積能力，朝更好的數位產品努力。",
];
---

<PageLayout>
  {/* Hero Section - HIG Design */}
  <section
    class="container mx-auto px-6 lg:px-8 py-24 md:py-32 border-b border-gray-200 dark:border-gray-800 relative z-10"
  >
    <div class="max-w-2xl">
      {/* 頂部標籤 */}
      <div
        class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 px-3 py-1.5 rounded-full text-sm font-medium mb-6"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        <HiOutlineSparkles className="w-4 h-4" />
        <span>歡迎來訪</span>
      </div>

      {/* 主標題 - 清晰的視覺層級 */}
      <h1
        class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white leading-tight mb-6"
        data-reveal
        style="--reveal-delay: 320ms"
      >
        我是 <span class="text-blue-600 dark:text-blue-400">張睿恩</span>
      </h1>

      <h2
        class="text-2xl md:text-3xl font-semibold text-gray-600 dark:text-gray-300 mb-6"
        data-reveal
        style="--reveal-delay: 440ms"
      >
        全端開發者
      </h2>

      {/* 描述文字 - 固定高度防止版面移動 */}
      <TypewriterText
        texts={descriptions}
        typingSpeed={50}
        deletingSpeed={30}
        delayBetweenTexts={2000}
        class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-8 max-w-xl min-h-22 lxgw-wenkai-mono-tc-regular"
        data-reveal
        style="--reveal-delay: 560ms"
      />

      {/* 主要行動按鈕 - 清晰且易於識別 */}
      <div
        class="flex flex-col sm:flex-row gap-4"
        data-reveal
        style="--reveal-delay: 680ms"
      >
        <div class="hover:translate-x-1 active:scale-[0.98] transition">
          <a
            href="/projects"
            class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3.5 rounded-lg font-medium transition-colors duration-200"
          >
            查看作品
            <HiOutlineArrowRight className="w-4 h-4" />
          </a>
        </div>
        <div class="hover:scale-[1.02] active:scale-[0.98] transition">
          <a
            href="/about"
            class="inline-flex items-center justify-center gap-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white px-6 py-3.5 rounded-lg font-medium transition-colors duration-200"
          >
            了解更多
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Navigation Grid - HIG Design with Clear Hierarchy */}
  <section class="container mx-auto px-6 lg:px-8 py-24 md:py-32 relative z-10">
    <div class="max-w-4xl">
      {/* Section Title */}
      <h2
        class="text-4xl font-bold text-gray-900 dark:text-white mb-4"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        探索內容
      </h2>
      <p
        class="text-lg text-gray-600 dark:text-gray-400 mb-12 lxgw-wenkai-mono-tc-regular"
        data-reveal
        style="--reveal-delay: 320ms"
      >
        了解更多關於我的背景、技能和作品
      </p>

      {/* Navigation Grid */}
      <div class="grid md:grid-cols-2 gap-6">
        {
          [
            {
              href: "/about",
              icon: "👨‍💻",
              title: "關於我",
              description: "背景故事與專業經歷",
            },
            {
              href: "/skills",
              icon: "🛠️",
              title: "技能專長",
              description: "技術能力與工具掌握",
            },
            {
              href: "/projects",
              icon: "🚀",
              title: "精選專案",
              description: "代表作品與案例",
            },
            {
              href: "/contact",
              icon: "✉️",
              title: "聯絡我",
              description: "尋求合作或交流",
            },
          ].map((item, i) => (
            <div
              class="group hover:-translate-y-1 transition"
              data-reveal
              style={`--reveal-delay: ${440 + i * 120}ms`}
            >
              <a
                href={item.href}
                class="block p-6 bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition-colors duration-200 border border-gray-200 dark:border-gray-800"
              >
                <div class="flex items-start gap-4">
                  <span class="text-3xl">{item.icon}</span>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                      {item.description}
                    </p>
                  </div>
                  <HiOutlineArrowRight className="w-5 h-5 text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors shrink-0 mt-0.5" />
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }
  window.scrollTo(0, 0);
</script>
